PORT=4000
NODE_ENV=local
DEPLOYMENT_ENV=canary

# Database
DATABASE_URL=postgresql://backend:let-me-in@localhost:5431/database?schema=public

# Admin routes
ADMIN_API_KEY=<chose-a-value>

# Reporting
SENTRY_DSN=https://123@oi456.ingest.sentry.io/123
APOLLO_SCHEMA_REPORTING=false

# RPC (Sonic via direct.dev)
DIRECT_API_KEY=

# Prices / APRs
COINGECKO_API_KEY=
MERKL_API_KEY=

# Process role. Leave all false to run the API only.
WORKER=false
SCHEDULER=false
# Scheduler -> worker transport. A localhost URL posts jobs directly over HTTP.
WORKER_QUEUE_URL=http://localhost:4000

# SOR. true = run the SOR in-process instead of proxying to SOR_SERVICE_URL
SOR_INSTANCE=true
SOR_SERVICE_URL=http://localhost:4000/graphql

