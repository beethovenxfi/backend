// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
  binaryTargets = ["native", "linux-arm64-openssl-1.0.x"] //, "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Chain {
    SONIC
}

model PrismaLastBlockSynced {
    @@id([category, chain])

    category            PrismaLastBlockSyncedCategory
    chain               Chain       @default(SONIC)
    blockNumber         Int
}

enum PrismaLastBlockSyncedCategory {
    POOLS
    POOLS_V3
    ADD_POOLS_V3
    SNAPSHOTS
    BPT_BALANCES_V2
    BPT_BALANCES_V3
    GAUGE_BALANCES
    JOIN_EXITS_V2
    SWAPS_V2
    JOIN_EXITS_V3
    SWAPS_V3
}

model PrismaJobStatus {
    @@id([name, chain])

    name                String
    chain               Chain
    intervalMs          Int
    lastStart           DateTime?
    lastSuccess         DateTime?
    lastDurationMs      Int?
    lastError           DateTime?
    lastErrorMessage    String?

}
